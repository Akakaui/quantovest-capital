# Supabase project URL and publishable browser key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key

# Server-only Supabase service key for controlled media uploads and admin jobs
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SUPABASE_MEDIA_BUCKET=quantovest-media

# Current Drizzle connection placeholder; use the Supabase Postgres pooler URL after the dialect migration
DATABASE_URL=postgresql://postgres:password@pooler.supabase.com:6543/postgres

# Auth.js compatibility values while the provider/session layer is being migrated to Supabase Auth
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000

# Optional OAuth provider credentials if Auth.js remains enabled
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
EMAIL_SERVER=
EMAIL_FROM=
