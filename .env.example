# Supabase project URL and publishable browser key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key

# Server-only Supabase service key for controlled media uploads and admin jobs
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SUPABASE_MEDIA_BUCKET=quantovest-media

# Database (Supabase Postgres transaction pooler; copy the exact host from Supabase Connect)
# Example for this project’s region: aws-1-eu-west-1.pooler.supabase.com
DATABASE_URL=postgresql://postgres.project-ref:password@aws-1-eu-west-1.pooler.supabase.com:6543/postgres

# App URL (used in email templates and redirects)
APP_PUBLIC_URL=http://localhost:3000

# Tawk.to public widget configuration (from the correct production property)
NEXT_PUBLIC_TAWK_PROPERTY_ID=replace-with-tawk-property-id
NEXT_PUBLIC_TAWK_WIDGET_ID=replace-with-tawk-widget-id

# Transactional Email (Resend)
# Get a free API key at https://resend.com
# Without this, emails are logged to console only (dev mode)
RESEND_API_KEY=
EMAIL_FROM=Quantovest Capital <notifications@yourdomain.com>

# Optional OAuth provider credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
