# MySQL/TiDB connection used by Drizzle and the Auth.js adapter
DATABASE_URL=mysql://user:password@host:3306/quantovest

# Auth.js signing/session secret
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000

# Optional Google OAuth provider
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Apple Sign in provider
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Optional passwordless email provider
EMAIL_SERVER=smtp://user:password@smtp.example.com:587
EMAIL_FROM=Quantovest <no-reply@example.com>
